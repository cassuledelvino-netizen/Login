@page
@model RegisterModel
@{
    ViewData["Title"] = "Criar Conta";
}

<div class="d-flex justify-content-center align-items-center min-vh-100 py-5">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 100%; max-width: 450px;">
        <div class="card-body">
            
            <!-- Cabeçalho -->
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Criar nova conta</h3>
                <p class="text-muted small">Preencha os dados abaixo para se cadastrar</p>
            </div>

            <!-- Formulário de Cadastro -->
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

                <!-- Campo E-mail -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nome@exemplo.com" />
                    <label asp-for="Input.Email">Endereço de E-mail</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <!-- Campo Senha -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Senha" />
                    <label asp-for="Input.Password">Senha</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <!-- Campo Confirmar Senha -->
                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmar Senha" />
                    <label asp-for="Input.ConfirmPassword">Confirmar Senha</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <!-- Botão de Cadastro -->
                <button id="registerSubmit" type="submit" class="btn btn-primary w-100 py-2.5 fw-bold rounded-3 shadow-sm mb-3">
                    Cadastrar
                </button>

                <!-- Link para Voltar ao Login -->
                <div class="text-center pt-2 border-top">
                    <span class="text-muted small">Já possui uma conta?</span>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none small fw-bold text-primary ms-1">
                        Fazer Login
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}